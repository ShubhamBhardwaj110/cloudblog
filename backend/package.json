{
  "name": "@cloudblog/backend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:legacy": "esbuild scripts/migrate-legacy.ts --bundle --platform=node --format=esm --log-level=warning --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=.scripts-dist/migrate.mjs && node .scripts-dist/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1178.0",
    "@aws-sdk/client-dynamodb": "^3.1178.0",
    "@aws-sdk/client-lambda": "^3.1178.0",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/client-sns": "^3.1178.0",
    "@aws-sdk/lib-dynamodb": "^3.1178.0",
    "@aws-sdk/s3-presigned-post": "^3.1178.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "marked": "^18.3.0",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.10",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
